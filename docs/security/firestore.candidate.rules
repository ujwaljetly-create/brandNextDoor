// CANDIDATE ONLY — DO NOT DEPLOY without complete emulator + workflow testing.
// Production currently has public wildcard allow; this replaces, not augments, it.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    function owner(field) { return signedIn() && resource.data[field] == request.auth.uid; }
    function newOwner(field) { return signedIn() && request.resource.data[field] == request.auth.uid; }
    function unchanged(fields) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields); }
    function chatMember() { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants; }

    match /ai_wallets/{uid} {
      allow read, write: if false;
      match /{document=**} { allow read, write: if false; }
    }

    match /users/{uid} {
      allow get: if me(uid);
      allow list: if false;
      allow create: if me(uid) && request.resource.data.uid == uid;
      allow update: if me(uid) && unchanged(['uid', 'email', 'createdAt']);
      allow delete: if false;
    }

    match /brands/{brandId} {
      allow read: if true; // Public storefront fields; move private data elsewhere.
      allow create: if newOwner('sellerId') && request.resource.data.brandId == brandId;
      allow update: if owner('sellerId') && unchanged(['sellerId', 'brandId', 'rating', 'totalReviews']);
      allow delete: if owner('sellerId');
      match /followers/{followerId} {
        allow read: if true;
        allow create, delete: if me(followerId);
        allow update: if false;
      }
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if newOwner('sellerId') && request.resource.data.listingId == listingId
        && request.resource.data.soldCount == 0
        && request.resource.data.rating == 0 && request.resource.data.reviewCount == 0;
      // The existing OrderService updates soldCount in a client transaction.
      // Migrate that update to a trusted function before enabling these rules.
      allow update: if owner('sellerId') && unchanged(['sellerId', 'listingId', 'brandId', 'soldCount', 'rating', 'reviewCount']);
      allow delete: if owner('sellerId');
    }

    match /orders/{orderId} {
      allow get, list: if signedIn() &&
        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      // WARNING: client-supplied prices, sellerId and amount are not authoritative.
      // Move order creation to a callable function before deploying this candidate.
      allow create: if false;
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && unchanged(['chatId', 'participants', 'buyerId', 'sellerId', 'brandId']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if chatMember();
        allow create: if chatMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.chatId == chatId
          && request.resource.data.receiverId in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update: if chatMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
          && request.auth.uid == resource.data.receiverId
          && request.resource.data.isRead == true;
        allow delete: if false;
      }
    }

    // All other paths intentionally denied until each client workflow is audited.
    match /{document=**} { allow read, write: if false; }
  }
}
